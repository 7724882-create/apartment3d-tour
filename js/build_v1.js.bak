}
function rug(scene, x, z, w, l, t, rot = 0) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, 0.012, l), M('#ffffff', { map: t, roughness: 1 })); m.position.set(x, 0.006, z); m.rotation.y = rot; m.receiveShadow = true; scene.add(m);
}
function picture(scene, x, y, z, w, h, dir, seed) {
  const c = document.createElement('canvas'); c.width = 256; c.height = Math.round(256 * h / w); const g2 = c.getContext('2d');
  const gr = g2.createLinearGradient(0, 0, 0, c.height); gr.addColorStop(0, '#9fb6c9'); gr.addColorStop(0.55, '#e7d6aa'); gr.addColorStop(0.56, '#6c7f45'); gr.addColorStop(1, '#3f4b2a'); g2.fillStyle = gr; g2.fillRect(0, 0, 256, c.height);
  let s = seed; const r = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  for (let i = 0; i < 40; i++) { g2.fillStyle = `hsl(${80 + r() * 50},40%,${20 + r() * 25}%)`; g2.beginPath(); g2.arc(r() * 256, c.height * (0.4 + r() * 0.25), 6 + r() * 18, 0, 7); g2.fill(); }
  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace;
  const grp = new THREE.Group(); B(w + 0.08, h + 0.08, 0.03, M('#8a6a30', { metalness: 0.5, roughness: 0.4 }), 0, -0.04, 0, 0.01, grp);
  const p = new THREE.Mesh(new THREE.PlaneGeometry(w, h), M('#ffffff', { map: t, roughness: 0.6 })); p.position.set(0, h / 2, 0.016); grp.add(p);
  grp.position.set(x, y - h / 2, z); grp.rotation.y = (180 - dir) * D2R; scene.add(grp);
}
function plant(scene, x, y, z, s = 1) {
  const g = new THREE.Group(); Cyl(0.11 * s, 0.08 * s, 0.18 * s, M('#a0522d', { roughness: 0.8 }), 0, 0, 0, g);
  const lm = M('#3f6b2a', { roughness: 0.7 }); for (let i = 0; i < 9; i++) { const a = i * 2.4; Sph(0.1 * s, lm, Math.cos(a) * 0.08 * s, (0.25 + (i % 3) * 0.08) * s, Math.sin(a) * 0.08 * s, g, 1, 0.5, 1.6).rotation.y = a; }
  g.position.set(x, y, z); scene.add(g);
}

// ---------- кухня, ванная, туалет
function kitchenRun(len, withSink, withStove) {
  const g = new THREE.Group(); const front = M('#ffffff', { map: TX.woodLight, roughness: 0.35 }); const carcass = M('#e9dcc4', { roughness: 0.6 });
  const top = M('#d8cbb0', { roughness: 0.3, map: TX.linoK }); const handle = chrome();
  B(len, 0.1, 0.55, M('#3a2a1a'), 0, 0, -0.02, 0, g);
  B(len, 0.75, 0.56, carcass, 0, 0.1, 0, 0.005, g);
  B(len + 0.02, 0.035, 0.62, top, 0, 0.85, 0.02, 0.008, g);
  const nd = Math.round(len / 0.5); const dw = len / nd;
  for (let i = 0; i < nd; i++) { const cx = -len / 2 + dw * (i + 0.5); B(dw - 0.008, 0.7, 0.02, front, cx, 0.12, 0.29, 0.006, g); B(dw - 0.008, 0.012, 0.022, M('#c2a070'), cx, 0.66, 0.295, 0, g); B(0.12, 0.012, 0.012, handle, cx, 0.75, 0.31, 0.004, g); }
  // фартук из плитки
  const tw = TX.tileWall.clone(); tw.repeat.set(len / 0.25, 0.65 / 0.25); tw.needsUpdate = true;
  const ap = new THREE.Mesh(new THREE.PlaneGeometry(len, 0.62), M('#ffffff', { map: tw, roughness: 0.15 })); ap.position.set(0, 0.885 + 0.31, -0.275); g.add(ap);
  // навесные шкафы
  for (let i = 0; i < nd; i++) { const cx = -len / 2 + dw * (i + 0.5); if (withStove && Math.abs(cx - withStove) < 0.3) continue; B(dw - 0.008, 0.7, 0.32, front, cx, 1.55, -0.12, 0.008, g); B(0.012, 0.12, 0.012, handle, cx + dw / 2 - 0.05, 1.6, 0.05, 0.004, g); }
  if (withSink !== undefined) {
    const sx = withSink; const st = M('#cfd3d6', { metalness: 0.9, roughness: 0.25 });
    B(0.5, 0.01, 0.48, st, sx, 0.882, 0.02, 0, g); B(0.4, 0.01, 0.36, M('#9ea3a6', { metalness: 0.9, roughness: 0.3 }), sx - 0.02, 0.888, 0.02, 0, g);
    const tap = Cyl(0.012, 0.012, 0.28, chrome(), sx, 0.89, -0.2, g); const sp = Cyl(0.01, 0.01, 0.2, chrome(), sx, 1.15, -0.12, g); sp.rotation.x = Math.PI / 2; sp.position.y = 1.16;
  }
  if (withStove !== undefined) { // газовая плита «Гефест»
    const sx = withStove; const wm = M('#f4f4f2', { roughness: 0.25 });
    B(0.5, 0.85, 0.58, wm, sx, 0, 0.01, 0.01, g); B(0.44, 0.38, 0.01, M('#1c1c1c', { roughness: 0.05 }), sx, 0.2, 0.3, 0.01, g);
    B(0.4, 0.012, 0.012, chrome(), sx, 0.62, 0.32, 0.004, g);
    for (const [dx, dz] of [[-0.12, -0.12], [0.12, -0.12], [-0.12, 0.1], [0.12, 0.1]]) { Cyl(0.05, 0.05, 0.012, M('#222', { metalness: 0.6, roughness: 0.4 }), sx + dx, 0.85, dz, g); Cyl(0.035, 0.035, 0.01, M('#555', { metalness: 0.8 }), sx + dx, 0.862, dz, g); }
    for (let k = 0; k < 4; k++) Cyl(0.02, 0.02, 0.02, M('#333'), sx - 0.15 + k * 0.1, 0.74, 0.3, g).rotation.x = Math.PI / 2;
    B(0.6, 0.15, 0.48, wm, sx, 1.65, -0.06, 0.02, g); // вытяжка
  }
  return g;
}
function fridge() { const g = new THREE.Group(); const w = M('#f6f6f3', { roughness: 0.2 }); B(0.6, 1.85, 0.62, w, 0, 0, 0, 0.04, g); B(0.59, 0.005, 0.02, M('#aaa'), 0, 1.25, 0.31, 0, g); B(0.025, 0.3, 0.03, M('#d8d8d8', { roughness: 0.3 }), 0.24, 1.35, 0.32, 0.01, g); B(0.025, 0.25, 0.03, M('#d8d8d8', { roughness: 0.3 }), 0.24, 0.85, 0.32, 0.01, g); return g; }
function bathTub() {
