  place(scene, sink(), 8.95, 1.5 + T + 0.22, 180);
  towelRail(scene, 8.0 + T + 0.02, 1.2, 2.25, 90);
  plafond(scene, 9.1, 2.4, 5);
  { const sh = new THREE.Group(); B(0.6, 0.02, 0.18, M('#f4f4f2', { roughness: 0.2 }), 0, 0, 0, 0.005, sh);
    const cols = ['#2f7fb5', '#e9e3d6', '#d9534f', '#7bbf6a', '#f0c040']; cols.forEach((c, i) => Cyl(0.03, 0.03, 0.14 + (i % 2) * 0.06, M(c, { roughness: 0.3 }), -0.22 + i * 0.11, 0.02, 0, sh, 12));
    place(scene, sh, 9.05, 3.27 - T - 0.1, 0, false, 1.25); }
  { const tw = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.45, 0.35), M('#7fa6c9', { roughness: 1 })); tw.position.set(8.0 + T + 0.05, 1.05, 2.25); tw.castShadow = true; scene.add(tw); }
  { const mat = new THREE.Mesh(new RoundedBoxGeometry(0.5, 0.012, 0.8, 2, 0.005), M('#6f9bbf', { roughness: 1 })); mat.position.set(9.4, 0.006, 2.4); scene.add(mat); }
  // === Туалет
  place(scene, toilet(), 9.2 - T - 0.3, 3.9, 270);
  pipes(scene, 9.2 - T - 0.08, 3.37 + 0.02);
  { const sh = new THREE.Group(); B(0.9, 0.02, 0.25, M('#f4f4f2'), 0, 0, 0, 0.005, sh); place(scene, sh, 8.6, 4.5 - T - 0.13, 0, false, 1.8); }
  plafond(scene, 8.6, 3.9, 3);
