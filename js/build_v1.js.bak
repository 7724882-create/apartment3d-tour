  { const dr = new THREE.Group(); B(1.1, 0.85, 0.48, wdDark, 0, 0, 0, 0.01, dr); for (let i = 0; i < 3; i++) { B(1.04, 0.24, 0.02, wdDark, 0, 0.06 + i * 0.26, 0.24, 0.005, dr); B(0.16, 0.015, 0.02, M('#c9a24a', { metalness: 1, roughness: 0.3 }), 0, 0.18 + i * 0.26, 0.26, 0.004, dr); }
    place(scene, dr, 3.7 - T - 0.25, 6.9, 270); const mir = new THREE.Mesh(new THREE.PlaneGeometry(0.7, 0.9), mirrorM()); mir.position.set(3.7 - T - 0.005, 1.5, 6.9); mir.rotation.y = -Math.PI / 2; scene.add(mir); }
