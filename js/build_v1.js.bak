  // === Лоджия
  place(scene, table(0.6, 0.6, 0.65, M('#ffffff', { map: TX.woodMid }), M('#ffffff', { map: TX.woodMid })), 5.7, 9.8, 180);
  const lwood = M('#ffffff', { map: TX.woodMid, roughness: 0.5 });
