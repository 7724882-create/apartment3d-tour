import * as THREE from 'three';
import { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';
import { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';
import { H, T, RECTS, OPENINGS } from './data.js';

export const solids = [];      // AABB препятствий для коллизий {x0,x1,z0,z1}
export const segments = [];    // отрезки стен для коллизий [x1,z1,x2,z2]
export const ceilings = [];    // объекты, скрываемые в режиме обзора
export const lights = [];
export const mirrors = [];
const mirrorM = () => { const m = new THREE.MeshStandardMaterial({ color: '#e8eef0', metalness: 1, roughness: 0.04 }); m.userData.mirror = true; return m; };

const D2R = Math.PI / 180;
let TX; // текстуры
const matCache = new Map();
export function M(color, o = {}) {
  const key = color + JSON.stringify(o, (k, v) => (v && v.isTexture ? v.uuid : v));
  if (matCache.has(key)) return matCache.get(key);
  const m = new THREE.MeshStandardMaterial({ color, roughness: 0.7, metalness: 0, ...o });
  matCache.set(key, m); return m;
}
const chrome = () => M('#d8dadc', { roughness: 0.12, metalness: 1 });
let _glass; const glassM = () => _glass || (_glass = new THREE.MeshLambertMaterial({ color: '#d6e8ea', transparent: true, opacity: 0.1, depthWrite: false }));
const whitePaint = () => M('#f2f0ea', { roughness: 0.45 });

// ---------- общие помощники
function worldUV(geom) {
  const p = geom.attributes.position, n = geom.attributes.normal; const uv = new Float32Array(p.count * 2);
  for (let i = 0; i < p.count; i++) {
    const nx = Math.abs(n.getX(i)), ny = Math.abs(n.getY(i)), nz = Math.abs(n.getZ(i));
    let u, v; if (ny > 0.5) { u = p.getX(i); v = -p.getZ(i); } else if (nx > nz) { u = p.getZ(i); v = p.getY(i); } else { u = p.getX(i); v = p.getY(i); }
    uv[i * 2] = u; uv[i * 2 + 1] = v;
  }
  geom.setAttribute('uv', new THREE.BufferAttribute(uv, 2)); return geom;
}
const archBatches = new Map(); // материал -> геометрии (сливаются в один меш)
function addArch(matKey, mat, geom) { if (!archBatches.has(matKey)) archBatches.set(matKey, { mat, list: [] }); archBatches.get(matKey).list.push(geom); }
function boxW(cx, cy, cz, sx, sy, sz) { const g = new THREE.BoxGeometry(sx, sy, sz); g.translate(cx, cy, cz); return worldUV(g); }

export function B(w, h, d, mat, x = 0, y = 0, z = 0, r = 0, parent) {
  const g = r > 0 ? new RoundedBoxGeometry(w, h, d, 2, Math.min(r, w / 2, h / 2, d / 2)) : new THREE.BoxGeometry(w, h, d);
  const m = new THREE.Mesh(g, mat); m.position.set(x, y + h / 2, z); m.castShadow = m.receiveShadow = true; if (parent) parent.add(m); return m;
}
function Cyl(rt, rb, h, mat, x, y, z, parent, seg = 20) { const m = new THREE.Mesh(new THREE.CylinderGeometry(rt, rb, h, seg), mat); m.position.set(x, y + h / 2, z); m.castShadow = m.receiveShadow = true; if (parent) parent.add(m); return m; }
function Sph(r, mat, x, y, z, parent, sx = 1, sy = 1, sz = 1) { const m = new THREE.Mesh(new THREE.SphereGeometry(r, 20, 14), mat); m.scale.set(sx, sy, sz); m.position.set(x, y, z); m.castShadow = m.receiveShadow = true; if (parent) parent.add(m); return m; }
// размещение: x,z — центр, dir — куда смотрит фасад (0 — вверх по плану, 90 — вправо, 180 — вниз, 270 — влево)
function place(scene, g, x, z, dir = 180, solid = true, y = 0) {
  g.position.set(x, y, z); g.rotation.y = (180 - dir) * D2R; scene.add(g); g.updateMatrixWorld(true);
  if (solid) { const b = new THREE.Box3().setFromObject(g); solids.push({ x0: b.min.x, x1: b.max.x, z0: b.min.z, z1: b.max.z }); }
  return g;
}
const inRect = (x, z, pred = () => true) => RECTS.find(r => pred(r) && x > r.x0 && x < r.x1 && z > r.z0 && z < r.z1);

// ---------- архитектура
function wallMatFor(rect) {
  const t = TX[rect.wall];
  return M('#ffffff', { map: t, roughness: rect.wall === 'pvc' ? 0.25 : 0.85 });
}
export function buildArchitecture(scene, textures) {
  TX = textures;
  const facadeM = M('#d9d2c4', { roughness: 0.95, map: TX.concrete });
  const slabM = M('#8f8a82', { roughness: 0.95, map: TX.concrete });
  const baseboardM = M('#6b4024', { roughness: 0.5 });
  const corniceM = M('#f7f5ef', { roughness: 0.6 });

  for (const r of RECTS) {
    // пол
    const fm = M('#ffffff', { map: TX[r.floor], roughness: r.floor === 'tile' ? 0.25 : r.floor === 'parquet' ? 0.35 : 0.55 });
    addArch('floor_' + r.floor, fm, boxW((r.x0 + r.x1) / 2, -0.01, (r.z0 + r.z1) / 2, r.x1 - r.x0, 0.02, r.z1 - r.z0));
    // плита перекрытия снизу (видна в режиме обзора)
    addArch('slab', slabM, boxW((r.x0 + r.x1) / 2, -0.17, (r.z0 + r.z1) / 2, r.x1 - r.x0 + (r.open ? 0 : 0.5), 0.3, r.z1 - r.z0 + (r.open ? 0 : 0.5)));
    // потолок
    const cg = new THREE.PlaneGeometry(r.x1 - r.x0, r.z1 - r.z0); cg.rotateX(Math.PI / 2); cg.translate((r.x0 + r.x1) / 2, r.open ? 2.75 : H, (r.z0 + r.z1) / 2);
    const cm = r.open ? M('#ffffff', { map: TX.concrete, side: THREE.DoubleSide, shadowSide: THREE.DoubleSide }) : M('#ffffff', { map: TX.ceiling, roughness: 0.9, shadowSide: THREE.DoubleSide });
    const ceil = new THREE.Mesh(worldUV(cg), cm); ceil.castShadow = true; ceil.receiveShadow = true; scene.add(ceil); ceilings.push(ceil);
    if (r.open) { // открытый балкон: бетонный парапет с перилами
      const pm = M('#ffffff', { map: TX.concrete, roughness: 0.95 });
      const rail = M('#3b3b3b', { roughness: 0.5, metalness: 0.6 });
      const sides = [[r.x0, r.z1, r.x0, r.z0], [r.x0, r.z0, r.x1, r.z0], [r.x1, r.z0, r.x1, r.z1]];
      for (const [ax, az, bx, bz] of sides) {
        const len = Math.hypot(bx - ax, bz - az), cx = (ax + bx) / 2, cz = (az + bz) / 2, hor = az === bz;
        const m = new THREE.Mesh(boxW(cx, 0.5, cz, hor ? len + 0.12 : 0.12, 1.0, hor ? 0.12 : len), pm); m.castShadow = m.receiveShadow = true; scene.add(m);
        const t = new THREE.Mesh(boxW(cx, 1.03, cz, hor ? len + 0.14 : 0.06, 0.05, hor ? 0.06 : len), rail); t.castShadow = true; scene.add(t);
        segments.push([ax, az, bx, bz]);
      }
      continue;
    }
    const wm = wallMatFor(r);
    const edges = [
      { o: 'h', at: r.z0, a: r.x0, b: r.x1, inw: 1 }, { o: 'h', at: r.z1, a: r.x0, b: r.x1, inw: -1 },
      { o: 'v', at: r.x0, a: r.z0, b: r.z1, inw: 1 }, { o: 'v', at: r.x1, a: r.z0, b: r.z1, inw: -1 },
    ];
    for (const e of edges) {
      const ops = OPENINGS.filter(op => op.o === e.o && Math.abs(op.at - e.at) < 0.01 && Math.min(op.b, e.b) - Math.max(op.a, e.a) > 0.01)
        .map(op => ({ ...op, a: Math.max(op.a, e.a), b: Math.min(op.b, e.b) })).sort((p, q) => p.a - q.a);
      const pieces = []; let cur = e.a;
      for (const op of ops) { if (op.a > cur) pieces.push([cur, op.a, 0, H]); if (op.bot > 0) pieces.push([op.a, op.b, 0, op.bot]); if (op.top < H) pieces.push([op.a, op.b, op.top, H]); cur = op.b; }
      if (cur < e.b) pieces.push([cur, e.b, 0, H]);
      for (const [a, b, y0, y1] of pieces) {
        const len = b - a, mid = (a + b) / 2, off = e.at + e.inw * T / 2;
        const g = e.o === 'h' ? boxW(mid, (y0 + y1) / 2, off, len, y1 - y0, T) : boxW(off, (y0 + y1) / 2, mid, T, y1 - y0, len);
        addArch('wall_' + r.wall, wm, g);
        const fo = e.at + e.inw * (T + 0.01);
        if (y0 === 0) {
          segments.push(e.o === 'h' ? [a, e.at, b, e.at] : [e.at, a, e.at, b]);
          if (r.wall !== 'pvc' && y1 > 0.3) addArch('baseboard', baseboardM, e.o === 'h' ? boxW(mid, 0.04, fo, len, 0.08, 0.022) : boxW(fo, 0.04, mid, 0.022, 0.08, len));
        }
        if (y1 === H && r.wall !== 'pvc' && r.wall !== 'clap') {
          const co = e.at + e.inw * (T + 0.02);
          addArch('cornice', corniceM, e.o === 'h' ? boxW(mid, H - 0.03, co, len, 0.06, 0.04) : boxW(co, H - 0.03, mid, 0.04, 0.06, len));
        }
        // фасад снаружи (там, где за стеной нет другого помещения)
        const step = 0.05; let runA = null;
        for (let s = a; s <= b + 1e-6; s += step) {
          const ss = Math.min(s + step / 2, b); const px = e.o === 'h' ? ss : e.at - e.inw * 0.12, pz = e.o === 'h' ? e.at - e.inw * 0.12 : ss;
          const outside = !inRect(px, pz, rr => !rr.open) && s < b - 1e-6;
          if (outside && runA === null) runA = s;
          if ((!outside || s >= b - 1e-6) && runA !== null) {
            const ra = runA, rb = Math.min(s, b), l = rb - ra, m2 = (ra + rb) / 2, fo2 = e.at - e.inw * 0.15;
            addArch('facade', facadeM, e.o === 'h' ? boxW(m2, (y0 + y1) / 2 - (y0 === 0 ? 0.15 : 0) + (y1 === H ? 0.15 : 0) / 1, fo2, l + 0.0, y1 - y0 + (y0 === 0 ? 0.3 : 0) + (y1 === H ? 0.3 : 0) - (y0 === 0 && y1 === H ? 0 : 0), 0.3)
              : boxW(fo2, (y0 + y1) / 2 - (y0 === 0 ? 0.15 : 0) + (y1 === H ? 0.15 : 0), m2, 0.3, y1 - y0 + (y0 === 0 ? 0.3 : 0) + (y1 === H ? 0.3 : 0), l));
            runA = null;
          }
        }
      }
    }
  }
  for (const [k, { mat, list }] of archBatches) {
    const m = new THREE.Mesh(mergeGeometries(list), mat); m.castShadow = true; m.receiveShadow = true; m.name = k; scene.add(m);
  }
  for (const op of OPENINGS) buildOpening(scene, op);
}

// ---------- окна и двери
function onEdge(op, s, y, n) { // точка: s вдоль стены, n — смещение поперёк
  return op.o === 'h' ? new THREE.Vector3(s, y, op.at + n) : new THREE.Vector3(op.at + n, y, s);
}
function insideSign(op) {
  const mid = (op.a + op.b) / 2;
  const test = sg => { const p = onEdge(op, mid, 0, sg * 0.3); return inRect(p.x, p.z, r => !r.open); };
  const p = test(1), m = test(-1);
  if (p && m) return p.id === 'loggia' ? -1 : 1;
  return p ? 1 : -1;
}
function edgeBox(scene, op, s0, s1, y0, y1, n0, n1, mat, shadow = true) {
  const a = onEdge(op, s0, y0, n0), b = onEdge(op, s1, y1, n1);
  const m = new THREE.Mesh(new THREE.BoxGeometry(Math.abs(b.x - a.x) || 0.001, Math.abs(b.y - a.y), Math.abs(b.z - a.z) || 0.001), mat);
  m.position.set((a.x + b.x) / 2, (a.y + b.y) / 2, (a.z + b.z) / 2); m.castShadow = shadow; m.receiveShadow = true; scene.add(m); return m;
}
function frameRect(scene, op, s0, s1, y0, y1, n, fw, depth, mat) {
  edgeBox(scene, op, s0, s1, y0, y0 + fw, n - depth / 2, n + depth / 2, mat);
  edgeBox(scene, op, s0, s1, y1 - fw, y1, n - depth / 2, n + depth / 2, mat);
  edgeBox(scene, op, s0, s0 + fw, y0, y1, n - depth / 2, n + depth / 2, mat);
  edgeBox(scene, op, s1 - fw, s1, y0, y1, n - depth / 2, n + depth / 2, mat);
}
function glassPane(scene, op, s0, s1, y0, y1, n) { const m = edgeBox(scene, op, s0, s1, y0, y1, n - 0.004, n + 0.004, glassM(), false); m.renderOrder = 2; return m; }

function buildOpening(scene, op) {
  const sg = insideSign(op), inside = sg * (T + 0.0);
  const casingM = M('#efe9dd', { roughness: 0.45 });
  if (op.kind === 'window' || op.kind === 'balcdoor') {
    const fm = whitePaint(); const n = 0, fw = 0.065, dep = 0.08;
    const { a, b, bot, top } = op;
    // откосы
    const revM = M('#efece4', { roughness: 0.8 });
    edgeBox(scene, op, a, b, top, top + 0.001, -0.25 * sg, sg * T, revM);
    // рама и створки
    frameRect(scene, op, a, b, bot, top, n, fw, dep, fm);
    const panes = op.panes || 1; const pw = (b - a) / panes;
    for (let i = 1; i < panes; i++) edgeBox(scene, op, a + i * pw - 0.03, a + i * pw + 0.03, bot, top, n - dep / 2, n + dep / 2, fm);
    if (op.kind === 'balcdoor') {
      edgeBox(scene, op, a + fw, b - fw, bot, 0.75, n - 0.02, n + 0.02, fm);
      glassPane(scene, op, a, b, 0.75, top, n);
    } else {
      // фрамуги в старых окнах
      const tr = top - 0.42; if (!op.pvc) edgeBox(scene, op, a, b, tr - 0.03, tr + 0.03, n - dep / 2, n + dep / 2, fm);
      // ручки
      for (let i = 0; i < panes; i++) { const h = edgeBox(scene, op, a + i * pw + pw - 0.08, a + i * pw + pw - 0.06, (bot + top) / 2 - 0.08, (bot + top) / 2 + 0.06, sg * 0.045, sg * 0.065, M('#f5f5f5', { roughness: 0.3 })); }
      glassPane(scene, op, a, b, bot, top, n);
      // подоконник
      if (op.bot > 0.3) {
        edgeBox(scene, op, a - 0.08, b + 0.08, bot - 0.04, bot, n, sg * (T + 0.25), M('#f4f2ec', { roughness: 0.35 }));
        if (!op.pvc) radiator(scene, op, sg);
      }
    }
    // шторы — только в жилых комнатах и кухне
    const rm = inRect(onEdge(op, (a + b) / 2, 0, sg * 0.5).x, onEdge(op, (a + b) / 2, 0, sg * 0.5).z);
    if (rm && ['r1', 'r2', 'r3', 'kitchen'].includes(rm.id) && !(rm.id === 'r3' && op.kind === 'balcdoor')) curtains(scene, op, sg, rm.id);
    if (rm && rm.id === 'r3' && op.kind === 'balcdoor') curtains(scene, op, sg, rm.id, true);
    return;
  }
  if (op.kind === 'void') return;
  // дверные наличники с двух сторон
  const cw = 0.07, { a, b, top } = op;
  for (const side of [1, -1]) {
    const nn = side * (T + 0.008);
    edgeBox(scene, op, a - cw, a, 0, top + cw, nn - 0.008, nn + 0.008, casingM);
    edgeBox(scene, op, b, b + cw, 0, top + cw, nn - 0.008, nn + 0.008, casingM);
    edgeBox(scene, op, a - cw, b + cw, top, top + cw, nn - 0.008, nn + 0.008, casingM);
  }
  const revM = M('#ece7dc', { roughness: 0.7 });
  edgeBox(scene, op, a, b, top, top + 0.002, -T, T, revM);
  if (op.kind === 'arch') return;
  if (op.kind === 'entry') { // входная дверь, обитая дерматином
    const leaf = edgeBox(scene, op, a + 0.02, b - 0.02, 0.01, top - 0.01, 0.0, 0.05 * sg, M('#ffffff', { map: TX.padded, roughness: 0.6 }));
    Sph(0.025, chrome(), ...onEdge(op, b - 0.12, 1.0, 0.08 * sg).toArray());
    edgeBox(scene, op, b - 0.16, b - 0.08, 1.0, 1.02, 0.06 * sg, 0.1 * sg, chrome());
    return;
  }
  // межкомнатные полотна, открытые настежь
  const leafDefs = { 'v3.7': ['a', -1, 92], 'h5.3': ['b', 1, 88], 'v8_2.6': ['b', 1, 88] };
  const key = op.o + op.at + (op.at === 8 ? '_' + op.a : '');
  if (op.kind === 'glassdouble') {
    const w = (b - a) / 2;
    makeLeaf(scene, op, a, w, -1, 82, true); makeLeaf(scene, op, b, -w, -1, 82, true);
    return;
  }
  const d = leafDefs[key]; if (!d) return;
  const [hinge, side, ang] = d; const w = b - a;
  makeLeaf(scene, op, hinge === 'a' ? a : b, hinge === 'a' ? w : -w, side, ang, op.at === 5.2);
}
function makeLeaf(scene, op, hingeS, w, side, angDeg, glass) {
  const g = new THREE.Group(); const L = Math.abs(w) - 0.02, Hh = op.top - 0.02;
  const wood = M('#ffffff', { map: TX.woodMid, roughness: 0.45 });
  if (glass) {
    B(L, 0.12, 0.04, wood, L / 2, 0, 0, 0.005, g); B(L, 0.1, 0.04, wood, L / 2, Hh - 0.1, 0, 0.005, g);
    B(0.1, Hh, 0.04, wood, 0.05, 0, 0, 0.005, g); B(0.1, Hh, 0.04, wood, L - 0.05, 0, 0, 0.005, g);
    B(L - 0.2, 0.06, 0.04, wood, L / 2, Hh * 0.45, 0, 0.005, g);
    const gl = new THREE.Mesh(new THREE.BoxGeometry(L - 0.2, Hh - 0.22, 0.006), M('#e8dcc0', { roughness: 0.2, transparent: true, opacity: 0.45 })); gl.position.set(L / 2, Hh / 2 + 0.01, 0); g.add(gl);
  } else {
    B(L, Hh, 0.04, wood, L / 2, 0, 0, 0.006, g);
    for (const yy of [0.25, 1.15]) B(L - 0.2, 0.7, 0.01, M('#ffffff', { map: TX.woodMid, roughness: 0.4, color: '#e8d8c8' }), L / 2, yy, 0.022, 0.004, g);
  }
  Cyl(0.02, 0.02, 0.02, M('#c9a24a', { metalness: 1, roughness: 0.3 }), L - 0.07, 1.0, 0.035, g).rotation.x = Math.PI / 2;
  Cyl(0.02, 0.02, 0.02, M('#c9a24a', { metalness: 1, roughness: 0.3 }), L - 0.07, 1.0, -0.035, g).rotation.x = Math.PI / 2;
  const sgnW = Math.sign(w);
  // в локальных координатах полотно лежит вдоль +X от петли; поворачиваем внутрь нужной комнаты
  const p = onEdge(op, hingeS, 0, 0); g.position.copy(p);
  let base = op.o === 'h' ? (sgnW > 0 ? 0 : Math.PI) : (sgnW > 0 ? -Math.PI / 2 : Math.PI / 2);
  // направление открытия
  const a = angDeg * D2R;
  const cross = op.o === 'h' ? side * sgnW : -side * sgnW;
  g.rotation.y = base - cross * a;
  g.traverse(o => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });
  scene.add(g);
}
function radiator(scene, op, sg) {
  const g = new THREE.Group(); const n = Math.max(6, Math.floor((op.b - op.a) * 0.55 / 0.09));
  const m = M('#f1efe9', { roughness: 0.35 });
  for (let i = 0; i < n; i++) { B(0.07, 0.55, 0.12, m, i * 0.09, 0, 0, 0.02, g); }
  Cyl(0.015, 0.015, n * 0.09, m, (n - 1) * 0.09 / 2, -0.015, 0, g).rotation.z = Math.PI / 2;
  const mid = (op.a + op.b) / 2; const p = onEdge(op, mid, 0.15, sg * (T + 0.1));
  g.position.set(p.x, 0.15, p.z); if (op.o === 'v') g.rotation.y = Math.PI / 2;
  g.children.forEach(c => c.position.x -= (n - 1) * 0.09 / 2);
  scene.add(g);
}
function folds(width, height, nf, amp) {
  const g = new THREE.PlaneGeometry(width, height, nf * 8, 1); const p = g.attributes.position;
  for (let i = 0; i < p.count; i++) p.setZ(i, Math.sin(p.getX(i) / width * nf * Math.PI * 2) * amp);
  g.computeVertexNormals(); return g;
}
function curtains(scene, op, sg, room, tulleOnly) {
  const span = op.b - op.a + 0.5, mid = (op.a + op.b) / 2, n = sg * (T + 0.22);
  const top = H - 0.08, hgt = room === 'kitchen' ? 1.6 : top - 0.02;
  const rodM = M('#b89a62', { metalness: 0.6, roughness: 0.35 });
  edgeBox(scene, op, mid - span / 2 - 0.05, mid + span / 2 + 0.05, top, top + 0.03, n - 0.015, n + 0.015, rodM);
  const tulleM = new THREE.MeshStandardMaterial({ map: TX.tulle, transparent: true, opacity: 0.42, side: THREE.DoubleSide, roughness: 1, depthWrite: false, alphaMap: null });
  const tt = TX.tulle.clone(); tt.repeat.set(span / 0.2, hgt / 0.2); tt.needsUpdate = true; tulleM.map = tt;
  const tl = new THREE.Mesh(folds(span, hgt, Math.round(span * 6), 0.025), tulleM); tl.renderOrder = 3;
  const p = onEdge(op, mid, top - hgt / 2, n - sg * 0.03); tl.position.copy(p); if (op.o === 'v') tl.rotation.y = Math.PI / 2; scene.add(tl);
  if (tulleOnly || room === 'kitchen') return;
  const cm = M('#ffffff', { map: TX.curtain, side: THREE.DoubleSide, roughness: 1 });
  for (const s of [-1, 1]) {
    const w = 0.55; const c = new THREE.Mesh(folds(w, hgt, 4, 0.05), cm); c.castShadow = true; c.receiveShadow = true;
    const q = onEdge(op, mid + s * (span / 2 - w / 2 + 0.05), top - hgt / 2, n + sg * 0.03); c.position.copy(q); if (op.o === 'v') c.rotation.y = Math.PI / 2; scene.add(c);
  }
}

// ---------- освещение-люстры
function addLight(scene, x, y, z, intensity = 9, color = '#ffd2a0', dist = 9) {
  const l = new THREE.PointLight(color, intensity, dist, 2); l.position.set(x, y, z); scene.add(l); lights.push(l); return l;
}
const bulbM = () => M('#fff3dc', { emissive: '#ffe2b0', emissiveIntensity: 2.2, roughness: 0.3 });
function chandelier(scene, x, z, arms = 5, intensity = 10) {
  const g = new THREE.Group(); const gold = M('#c8a05a', { metalness: 1, roughness: 0.3 });
  const shade = M('#f6efe0', { roughness: 0.2, transparent: true, opacity: 0.85, emissive: '#ffdcae', emissiveIntensity: 0.9 });
  Cyl(0.05, 0.05, 0.02, gold, 0, -0.02, 0, g); Cyl(0.008, 0.008, 0.38, gold, 0, -0.4, 0, g);
  Sph(0.05, gold, 0, -0.42, 0, g);
  const ring = new THREE.Mesh(new THREE.TorusGeometry(0.26, 0.008, 8, 40), gold); ring.rotation.x = Math.PI / 2; ring.position.y = -0.45; g.add(ring);
  for (let i = 0; i < arms; i++) {
    const a = i / arms * Math.PI * 2, cx = Math.cos(a) * 0.26, cz = Math.sin(a) * 0.26;
    const arm = Cyl(0.006, 0.006, 0.26, gold, cx / 2, -0.43, cz / 2, g); arm.rotation.set(0, -a, Math.PI / 2); arm.position.y = -0.43;
    const s = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.085, 0.13, 18, 1, true), shade); s.position.set(cx, -0.38, cz); g.add(s);
    Sph(0.03, bulbM(), cx, -0.4, cz, g);
  }
  g.position.set(x, H, z); scene.add(g); ceilings.push(g);
  addLight(scene, x, H - 0.55, z, intensity);
}
function pendant(scene, x, z, drop = 0.9, intensity = 4) {
  const g = new THREE.Group(); Cyl(0.004, 0.004, drop, M('#222'), 0, -drop, 0, g);
  const sh = new THREE.Mesh(new THREE.ConeGeometry(0.16, 0.18, 24, 1, true), M('#f1e6cf', { side: THREE.DoubleSide, roughness: 0.5, emissive: '#ffdcae', emissiveIntensity: 0.35 }));
  sh.position.y = -drop - 0.06; g.add(sh); Sph(0.035, bulbM(), 0, -drop - 0.1, 0, g);
  Cyl(0.04, 0.04, 0.02, M('#f1e6cf'), 0, -0.02, 0, g);
  g.position.set(x, H, z); scene.add(g); ceilings.push(g);
  addLight(scene, x, H - drop - 0.15, z, intensity);
}
function plafond(scene, x, z, intensity = 5) {
  const p = Sph(0.15, M('#fff8ea', { emissive: '#ffe7c4', emissiveIntensity: 1.2, roughness: 0.2 }), x, H - 0.05, z, scene, 1, 0.4, 1); ceilings.push(p);
  addLight(scene, x, H - 0.25, z, intensity);
}

// ---------- мебель (локальные координаты: фасад смотрит в +Z, центр основания в нуле)
function sofa(w = 2.0, fab, legsM) {
  const g = new THREE.Group(); const f = M('#ffffff', { map: fab, roughness: 0.95 }); const d = 0.9;
  B(w, 0.3, d - 0.2, f, 0, 0.12, 0.08, 0.06, g);                      // основание
  B(w - 0.36, 0.14, d - 0.3, f, 0, 0.4, 0.12, 0.06, g);               // сиденье
  B(w - 0.3, 0.55, 0.22, f, 0, 0.4, -d / 2 + 0.13, 0.08, g);          // спинка
  for (const s of [-1, 1]) B(0.18, 0.62, d - 0.05, f, s * (w / 2 - 0.09), 0.08, 0, 0.07, g); // подлокотники
  for (let i = 0; i < 3; i++) B((w - 0.42) / 3 - 0.02, 0.32, 0.14, f, -((w - 0.42) / 3) + i * (w - 0.42) / 3, 0.52, -d / 2 + 0.3, 0.06, g).rotation.x = -0.18;
  for (const sx of [-1, 1]) for (const sz of [-1, 1]) Cyl(0.025, 0.02, 0.12, legsM, sx * (w / 2 - 0.08), 0, sz * (d / 2 - 0.08), g);
  return g;
}
function armchair(fab) {
