  plafond(scene, 5.45, 2.4, 6); plafond(scene, 5.2, 4.85, 3);
  { const mir = new THREE.Mesh(new THREE.PlaneGeometry(0.6, 0.9), mirrorM()); mir.position.set(6.15, 1.45, 1.5 + T + 0.01); scene.add(mir);
    B(0.66, 0.96, 0.02, M('#8a6a30', { metalness: 0.5, roughness: 0.4 }), 6.15, 1.0, 1.5 + T + 0.002, 0.01, scene); mir.position.z += 0.012; }
  picture(scene, 4.2 + T + 0.01, 1.8, 4.0, 0.5, 0.4, 90, 7);
  // === Коридор 4,8 (шкаф с арочным зеркалом)
  place(scene, wardrobe(1.5, 2.3, 0.42, TX.woodLight, { mirror: true, arched: true, doors: 3 }), 6.7 + T + 0.22, 4.35, 90);
  for (let i = 0; i < 4; i++) Sph(0.02, M('#c9a24a', { metalness: 1, roughness: 0.3 }), 6.82 + 0.0, 1.65, 1.75 + i * 0.12, scene);
  plafond(scene, 7.35, 3.2, 6);
