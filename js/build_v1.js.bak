  { const desk = table(1.1, 0.6, 0.75, wdDark, legs); place(scene, desk, 6.7 - T - 0.32, 7.8, 270); place(scene, chair(M('#ffffff', { map: TX.fabricBeige }), wdDark), 6.0, 7.8, 90); lamp(scene, 6.4, 0.75, 7.5); }
  rug(scene, 5.1, 7.1, 1.6, 2.2, TX.rug(17, '#7a2b20', '#e0c08a', '#2a3a5a'));
