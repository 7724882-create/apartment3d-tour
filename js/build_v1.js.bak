// ---------- окружение: двор, деревья, гаражи, соседние дома и панорама
export function buildOutside(scene, panoTex) {
  const ground = new THREE.Mesh(new THREE.PlaneGeometry(300, 300), M('#6f7d4a', { roughness: 1 })); ground.rotation.x = -Math.PI / 2; ground.position.y = -12; ground.receiveShadow = true; scene.add(ground);
  const asphalt = new THREE.Mesh(new THREE.PlaneGeometry(60, 10), M('#56575a', { roughness: 0.95 })); asphalt.rotation.x = -Math.PI / 2; asphalt.position.set(5, -11.98, 22); scene.add(asphalt);
  // фасад дома ниже и выше квартиры
  const facade = M('#d9d2c4', { roughness: 0.95, map: TX.concrete });
  for (const y of [-6.0, 7.2]) { const m = new THREE.Mesh(new THREE.BoxGeometry(11.2, y < 0 ? 11.7 : 9, 12.2), facade); m.position.set(5.0, y < 0 ? -6.15 : 2.86 + 4.5, 4.6); m.receiveShadow = true; m.castShadow = y > 0; m.userData.upper = y > 0; scene.add(m); if (y > 0) ceilings.push(m); }
  const r = (() => { let s = 42; return () => ((s = (s * 16807) % 2147483647) / 2147483647); })();
  const trunk = M('#4a3a2a'); const leafs = [M('#4f6e2e', { roughness: 0.9 }), M('#5e7c34', { roughness: 0.9 }), M('#3e5a26', { roughness: 0.9 })];
  for (let i = 0; i < 46; i++) {
    let x = -25 + r() * 60, z = -25 + r() * 60; if (x > -4 && x < 14 && z > -6 && z < 14) continue;
    const h = 8 + r() * 8; const t = Cyl(0.18, 0.28, h * 0.5, trunk, x, -12, z, scene, 8);
    for (let k = 0; k < 4; k++) Sph(1.6 + r() * 1.6, leafs[k % 3], x + (r() - 0.5) * 2, -12 + h * 0.55 + k * 1.1, z + (r() - 0.5) * 2, scene, 1, 1.1, 1);
  }
  // ряд гаражей во дворе
  for (let i = 0; i < 12; i++) { const g = B(3, 2.4, 6, M(['#7b6f60', '#8a7f72', '#6f6658'][i % 3], { roughness: 0.9 }), -12 + i * 3.1, -12, 26, 0, scene); B(2.4, 2.0, 0.05, M(['#4f6d7a', '#7a4f3a', '#5a6a4a', '#8a8a80'][i % 4], { roughness: 0.6, metalness: 0.4 }), -12 + i * 3.1, -12, 22.98, 0, scene); }
  for (let i = 0; i < 10; i++) { const g = B(3, 2.4, 6, M('#7d7468', { roughness: 0.9 }), -12 + i * 3.1, -12, -18, 0, scene); }
  // соседние дома
  const mk = (x, z, w, d, h, col, stripe) => { const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), M(col, { roughness: 0.9 })); m.position.set(x, -12 + h / 2, z); m.castShadow = true; scene.add(m); };
  mk(-30, 40, 14, 14, 50, '#e8e1d6'); mk(-8, 55, 40, 14, 48, '#e19a5a'); mk(35, 45, 14, 14, 55, '#ece6dc'); mk(42, -30, 14, 30, 40, '#b8664a'); mk(-35, -35, 16, 16, 52, '#a35a3e'); mk(10, -50, 50, 14, 36, '#ddd5c8');
  // панорама — большой цилиндр вокруг (неосвещённый материал, яркий как дневной свет)
  const cyl = new THREE.Mesh(new THREE.CylinderGeometry(140, 140, 140, 64, 1, true), new THREE.MeshBasicMaterial({ map: panoTex, side: THREE.BackSide, toneMapped: false, fog: false }));
  cyl.position.set(5, 18, 5); scene.add(cyl);
  return cyl;
}
