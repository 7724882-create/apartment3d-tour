  B(0.6, 0.18, 0.62, f, 0, 0.22, 0.04, 0.06, g); B(0.66, 0.62, 0.2, f, 0, 0.2, -0.32, 0.08, g);
  for (const s of [-1, 1]) B(0.14, 0.55, 0.78, f, s * 0.36, 0.12, 0, 0.06, g);
  B(0.58, 0.14, 0.6, f, 0, 0.1, 0.04, 0.03, g);
  for (const sx of [-1, 1]) for (const sz of [-1, 1]) Cyl(0.02, 0.02, 0.12, M('#2b1a10'), sx * 0.36, 0, sz * 0.32, g);
  return g;
}
function bed(w = 1.6, l = 2.05) {
  const g = new THREE.Group(); const wd = M('#ffffff', { map: TX.woodDark, roughness: 0.35 });
  B(w + 0.06, 0.32, l, wd, 0, 0.06, 0, 0.02, g);
  B(w + 0.1, 1.05, 0.06, wd, 0, 0, -l / 2, 0.02, g); B(w + 0.1, 0.55, 0.05, wd, 0, 0, l / 2, 0.02, g);
  B(w - 0.02, 0.2, l - 0.08, M('#efe9de', { roughness: 0.9 }), 0, 0.38, 0, 0.06, g);
  B(w + 0.08, 0.06, l - 0.25, M('#ffffff', { map: TX.bedspread, roughness: 0.95 }), 0, 0.56, 0.12, 0.03, g);
  for (const sz of [-1, 1]) B(w + 0.08, 0.3, 0.02, M('#ffffff', { map: TX.bedspread, roughness: 0.95 }), 0, 0.3, 0, 0, g).position.set(0, 0.47, 0.12 + sz * 0);
  for (const s of [-1, 1]) B(0.62, 0.14, 0.42, M('#f4ecdd', { roughness: 0.95 }), s * w / 4, 0.57, -l / 2 + 0.3, 0.07, g);
  return g;
}
function nightstand() { const g = new THREE.Group(); const wd = M('#ffffff', { map: TX.woodDark, roughness: 0.35 }); B(0.45, 0.5, 0.4, wd, 0, 0.05, 0, 0.01, g); B(0.4, 0.18, 0.01, wd, 0, 0.35, 0.2, 0, g); Sph(0.012, M('#c9a24a', { metalness: 1, roughness: 0.3 }), 0, 0.44, 0.21, g); for (const sx of [-1, 1]) for (const sz of [-1, 1]) B(0.03, 0.05, 0.03, wd, sx * 0.19, 0, sz * 0.16, 0, g); return g; }
function lamp(parent, x, y, z) {
  const g = new THREE.Group(); Cyl(0.06, 0.07, 0.03, M('#c8a05a', { metalness: 1, roughness: 0.3 }), 0, 0, 0, g); Cyl(0.01, 0.01, 0.28, M('#c8a05a', { metalness: 1, roughness: 0.3 }), 0, 0.03, 0, g);
  const s = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.14, 0.18, 20, 1, true), M('#efdcb8', { side: THREE.DoubleSide, emissive: '#ffd9a0', emissiveIntensity: 0.5 })); s.position.y = 0.36; g.add(s);
  g.position.set(x, y, z); parent.add(g); return g;
}
function wardrobe(w, h, d, woodTex, { mirror = false, arched = false, doors = 2 } = {}) {
  const g = new THREE.Group(); const wd = M('#ffffff', { map: woodTex, roughness: 0.4 });
  B(w, h - 0.08, d, wd, 0, 0.08, 0, 0.01, g); B(w - 0.04, 0.08, d - 0.04, M('#2a1a10'), 0, 0, 0, 0, g);
  B(w + 0.04, 0.04, d + 0.03, wd, 0, h - 0.04, 0.01, 0.01, g);
  const dw = w / doors;
  for (let i = 0; i < doors; i++) {
    const cx = -w / 2 + dw * (i + 0.5);
    B(dw - 0.01, h - 0.14, 0.02, wd, cx, 0.1, d / 2 + 0.005, 0.005, g);
    if (mirror && (i === Math.floor(doors / 2) || doors === 3 && i === 1)) {
      const mw = dw - 0.16, mh = h - 0.6;
      const shape = new THREE.Shape(); shape.moveTo(-mw / 2, 0); shape.lineTo(mw / 2, 0); shape.lineTo(mw / 2, mh - (arched ? mw / 2 : 0));
      if (arched) shape.absarc(0, mh - mw / 2, mw / 2, 0, Math.PI, false); else shape.lineTo(-mw / 2, mh);
      shape.lineTo(-mw / 2, 0);
      const mm = new THREE.Mesh(new THREE.ShapeGeometry(shape, 24), mirrorM());
      mm.position.set(cx, 0.35, d / 2 + 0.017); g.add(mm);
    } else {
      B(dw - 0.14, h - 0.5, 0.012, wd, cx, 0.3, d / 2 + 0.018, 0.004, g);
    }
    Cyl(0.008, 0.008, 0.14, M('#c9a24a', { metalness: 1, roughness: 0.3 }), cx + (i % 2 ? -1 : 1) * (dw / 2 - 0.06), 1.0, d / 2 + 0.04, g);
  }
  return g;
}
function booksRow(parent, w, y, z, h = 0.26) {
  const t = TX.books.clone(); t.repeat.set(w / 0.9, 1); t.offset.x = Math.random(); t.needsUpdate = true;
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, 0.18), [M('#6b3a2a'), M('#6b3a2a'), M('#e9dfc8'), M('#6b3a2a'), M('#ffffff', { map: t, roughness: 0.8 }), M('#6b3a2a')]);
  m.position.set(0, y + h / 2, z); m.castShadow = m.receiveShadow = true; parent.add(m); return m;
}
function crystal(parent, x, y, z) { const m = M('#ffffff', { roughness: 0.02, transparent: true, opacity: 0.5, envMapIntensity: 3 }); const g = Cyl(0.035, 0.025, 0.12, m, x, y, z, parent, 10); Cyl(0.06, 0.03, 0.08, m, x + 0.12, y, z, parent, 8); return g; }
function wallUnit(w = 3.3, h = 2.2, d = 0.45) { // советская «стенка»
  const g = new THREE.Group(); const wd = M('#ffffff', { map: TX.woodDark, roughness: 0.28 }); const sec = w / 4;
  const handle = M('#c9a24a', { metalness: 1, roughness: 0.3 });
  for (let i = 0; i < 4; i++) {
    const cx = -w / 2 + sec * (i + 0.5);
    if (i === 3) B(sec - 0.01, h, d, wd, cx, 0, 0, 0.005, g);
    else { B(sec - 0.01, 0.76, d, wd, cx, 0, 0, 0.005, g); B(sec - 0.01, h - 1.84, d, wd, cx, 1.84, 0, 0.005, g); B(0.02, 1.1, d, wd, cx - sec / 2 + 0.015, 0.76, 0, 0, g); B(0.02, 1.1, d, wd, cx + sec / 2 - 0.015, 0.76, 0, 0, g); B(sec - 0.02, 0.02, d, wd, cx, 1.62, 0, 0, g); }
    // нижние дверцы
    B(sec - 0.04, 0.68, 0.02, wd, cx, 0.06, d / 2, 0.005, g); Cyl(0.01, 0.01, 0.08, handle, cx + sec / 2 - 0.08, 0.5, d / 2 + 0.025, g);
    const inner = M('#3a2212', { roughness: 0.6 });
    if (i === 1) { // ниша под телевизор
      B(sec - 0.04, 1.1, 0.02, inner, cx, 0.76, -d / 2 + 0.03, 0, g);
      B(sec - 0.06, 0.73, d - 0.04, inner, cx, 0.79, 0.02, 0, g).visible = false;
      const tv = new THREE.Group(); B(0.62, 0.45, 0.42, M('#2a2a2a', { roughness: 0.4 }), 0, 0, 0, 0.03, tv);
      B(0.5, 0.36, 0.01, M('#151a1c', { roughness: 0.1, metalness: 0.2 }), -0.03, 0.05, 0.21, 0.02, tv);
      tv.position.set(cx, 0.82, 0); g.add(tv);
      
    } else if (i === 2 || i === 0) { // стеклянные секции с книгами и хрусталём
      B(sec - 0.06, 0.02, d - 0.06, wd, cx, 1.18, 0, 0, g);
      B(sec - 0.04, 1.1, 0.02, M('#3a2414', { roughness: 0.5 }), cx, 0.76, -d / 2 + 0.03, 0, g);
      const sub = new THREE.Group(); sub.position.x = cx; g.add(sub);
      if (i === 2) { booksRow(sub, sec - 0.1, 0.78, 0.0); booksRow(sub, sec - 0.1, 1.2, 0.0, 0.3); for (let k = 0; k < 4; k++) crystal(g, cx - 0.3 + k * 0.17, 1.64, 0.05); }
      else { for (let k = 0; k < 4; k++) { crystal(g, cx - 0.3 + k * 0.17, 0.79, 0.05); crystal(g, cx - 0.3 + k * 0.17, 1.2, 0.05); } booksRow(sub, sec - 0.1, 1.64, 0.0, 0.18); }
      const gl = B(sec - 0.06, 0.84, 0.008, M('#dfeeee', { roughness: 0.02, transparent: true, opacity: 0.18, envMapIntensity: 2.5, depthWrite: false }), cx, 0.77, d / 2 - 0.01, 0, g); gl.castShadow = false;
      for (const yy of [0.77, 1.6]) B(sec - 0.04, 0.025, 0.02, wd, cx, yy, d / 2 - 0.005, 0, g); for (const sx of [-1, 1]) B(0.025, 0.85, 0.02, wd, cx + sx * (sec / 2 - 0.03), 0.77, d / 2 - 0.005, 0, g);
    } else { // закрытый платяной отсек
      B(sec - 0.04, 1.38, 0.02, wd, cx, 0.76, d / 2, 0.005, g); Cyl(0.01, 0.01, 0.12, handle, cx - sec / 2 + 0.08, 1.2, d / 2 + 0.025, g);
    }
    B(sec - 0.04, 0.3, 0.02, wd, cx, 1.88, d / 2, 0.005, g);
  }
  B(w + 0.04, 0.04, d + 0.02, wd, 0, h, 0, 0.01, g);
  return g;
}
function bookshelf(w, h, d = 0.32, shelves = 5) {
  const g = new THREE.Group(); const wd = M('#ffffff', { map: TX.woodMid, roughness: 0.4 });
  B(0.02, h, d, wd, -w / 2 + 0.01, 0, 0, 0, g); B(0.02, h, d, wd, w / 2 - 0.01, 0, 0, 0, g); B(w, 0.01, d, M('#5a3a20'), 0, 0, -d / 2 + 0.005, 0, g).scale.set(1, h * 100, 0.03);
  for (let i = 0; i <= shelves; i++) { const y = i * (h - 0.02) / shelves; B(w - 0.04, 0.02, d, wd, 0, y, 0, 0, g); if (i < shelves) booksRow(g, w - 0.06, y + 0.02, 0.0, Math.min(0.3, (h / shelves) - 0.06)); }
  return g;
}
function table(w, d, h, topM, legM, { glass = false } = {}) {
  const g = new THREE.Group();
  if (glass) { const t = B(w, 0.012, d, M('#bfe0dc', { roughness: 0.03, transparent: true, opacity: 0.35, envMapIntensity: 2 }), 0, h - 0.012, 0, 0.004, g); t.castShadow = true; }
  else B(w, 0.035, d, topM, 0, h - 0.035, 0, 0.008, g);
  for (const sx of [-1, 1]) for (const sz of [-1, 1]) Cyl(0.018, 0.018, h - (glass ? 0.012 : 0.035), legM, sx * (w / 2 - 0.06), 0, sz * (d / 2 - 0.06), g, 12);
  if (glass) { B(w - 0.08, 0.02, 0.02, legM, 0, h - 0.04, d / 2 - 0.06, 0, g); B(w - 0.08, 0.02, 0.02, legM, 0, h - 0.04, -d / 2 + 0.06, 0, g); }
  return g;
}
function chair(seatM, frameM) {
  const g = new THREE.Group(); B(0.42, 0.05, 0.42, seatM, 0, 0.42, 0, 0.015, g);
  for (const sx of [-1, 1]) for (const sz of [-1, 1]) B(0.035, 0.42, 0.035, frameM, sx * 0.18, 0, sz * 0.18, 0.005, g);
  for (const sx of [-1, 1]) B(0.035, 0.48, 0.035, frameM, sx * 0.18, 0.47, -0.18, 0.005, g);
  B(0.4, 0.14, 0.025, frameM, 0, 0.76, -0.19, 0.008, g); B(0.4, 0.05, 0.025, frameM, 0, 0.58, -0.19, 0.008, g);
